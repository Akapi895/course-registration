// Schema MVP: 8 bảng, hai role student/admin; giảng viên là tên hiển thị trên lớp.
// CHECK được ghi trong note để dễ paste trên dbdiagram, chi tiết xem database-design.md.
// Không dùng delete trong cột hay khối refs; hành vi FK nằm trong Ref cấp ngoài.

Project course_registration {
  database_type: 'PostgreSQL'
  Note: 'Schema MVP theo docs/srs.md và docs/database-design.md'
}

Table users {
  id bigserial [pk, not null]
  username text [not null, unique]
  password_hash text [not null]
  role text [not null, note: 'CHECK: student, admin; mỗi tài khoản một role']
  full_name text [not null]
  student_code text [unique, note: 'Student bắt buộc; admin phải NULL']
  faculty text [note: 'Student bắt buộc']
  major text [note: 'Student bắt buộc']
  min_credits_exempt boolean [not null, default: false, note: 'Admin cấp ngoại lệ tối thiểu cho student; role khác phải false']
  created_at timestamptz [not null, default: `now()`]
}

Table semesters {
  id bigserial [pk, not null]
  name text [not null, unique]
  registration_opens_at timestamptz [not null]
  registration_closes_at timestamptz [not null, note: 'CHECK: closes > opens']
  min_credits int [not null, note: 'CHECK: >= 0 AND <= max_credits']
  max_credits int [not null, note: 'CHECK: > 0']
}

Table courses {
  id bigserial [pk, not null]
  code text [not null, unique]
  name text [not null]
  credits int [not null, note: 'CHECK: > 0']
  faculty text [not null]
  major text [note: 'NULL cho học phần dùng chung; nhãn phục vụ bộ lọc']
}

Table course_prerequisites {
  course_id bigint [not null]
  prerequisite_course_id bigint [not null, note: 'CHECK: khác course_id']

  indexes {
    (course_id, prerequisite_course_id) [pk]
  }
}

Table course_results {
  student_id bigint [not null, note: 'users.id có role student; kiểm tra role ở service/seed']
  course_id bigint [not null]
  passed boolean [not null]

  indexes {
    (student_id, course_id) [pk]
  }
}

Table course_classes {
  id bigserial [pk, not null]
  course_id bigint [not null]
  semester_id bigint [not null]
  lecturer_name text [not null, note: 'Tên giảng viên do admin nhập; không tham chiếu tài khoản']
  class_code text [not null]
  max_capacity int [not null, note: 'CHECK: > 0']
  enrolled int [not null, default: 0, note: 'CHECK: 0 <= enrolled AND enrolled <= max_capacity']

  indexes {
    (semester_id, class_code) [unique]
    semester_id
  }
}

Table class_schedules {
  id bigserial [pk, not null]
  class_id bigint [not null]
  day_of_week smallint [not null, note: 'CHECK: 1..7; 1 = thứ Hai']
  start_period smallint [not null, note: 'CHECK: > 0; đầu khoảng có tính']
  end_period smallint [not null, note: 'CHECK: >= start_period; cuối khoảng có tính']
  room text [not null]

  indexes {
    class_id
  }
}

Table registrations {
  id bigserial [pk, not null]
  student_id bigint [not null, note: 'users.id có role student; JWT xác định sinh viên, admin có thể thao tác cho sinh viên đích']
  class_id bigint [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (student_id, class_id) [unique]
    class_id
  }
}

Ref: course_prerequisites.course_id > courses.id [delete: no action]
Ref: course_prerequisites.prerequisite_course_id > courses.id [delete: no action]
Ref: course_results.student_id > users.id [delete: no action]
Ref: course_results.course_id > courses.id [delete: no action]
Ref: course_classes.course_id > courses.id [delete: no action]
Ref: course_classes.semester_id > semesters.id [delete: no action]
Ref: class_schedules.class_id > course_classes.id [delete: cascade]
Ref: registrations.student_id > users.id [delete: no action]
Ref: registrations.class_id > course_classes.id [delete: restrict]
