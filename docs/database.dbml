
Project course_registration {
  database_type: 'PostgreSQL'
  Note: 'Thiết kế cơ sở dữ liệu cho Phase 1'
}

// 1. Người dùng và sinh viên
Table users {
  id bigserial [pk]
  username text [not null, unique]
  password_hash text [not null]
  role text [not null, check: `role IN ('student', 'admin')`]
  full_name text [not null]
  student_code text [unique]
  faculty text
  major text
  created_at timestamptz [not null, default: `now()`]

  checks {
    `(role = 'student' AND student_code IS NOT NULL) OR (role = 'admin' AND student_code IS NULL)` [name: 'chk_user_student_code']
  }
}

// 2. Học kỳ và thời gian đăng ký
Table semesters {
  id bigserial [pk]
  name text [not null, unique]
  registration_opens_at timestamptz [not null]
  registration_closes_at timestamptz [not null]
  max_credits int [not null, check: `max_credits > 0`]

  checks {
    `registration_closes_at > registration_opens_at` [name: 'chk_registration_period']
  }
}

// 3. Học phần
Table courses {
  id bigserial [pk]
  code text [not null, unique, note: 'Mã học phần, ví dụ INT3401']
  name text [not null]
  credits int [not null, check: `credits > 0`]
  faculty text [not null]
  major text
}

// 4. Học phần tiên quyết
Table course_prerequisites {
  course_id bigint [not null]
  prerequisite_course_id bigint [not null]

  indexes {
    (course_id, prerequisite_course_id) [pk]
  }

  checks {
    `course_id <> prerequisite_course_id` [name: 'chk_different_prerequisite']
  }
}

// 5. Lớp học phần
Table course_classes {
  id bigserial [pk, note: 'Định danh nội bộ của lớp học phần']
  course_id bigint [not null]
  semester_id bigint [not null]
  class_code text [not null, note: 'Mã lớp học phần, ví dụ INT3401-01']
  lecturer_name text [not null]
  max_capacity int [not null, check: `max_capacity > 0`]
  enrolled int [not null, default: 0]
  status text [not null, default: 'active', check: `status IN ('active', 'cancelled')`]

  indexes {
    (semester_id, class_code) [unique]
  }

  checks {
    `enrolled >= 0 AND enrolled <= max_capacity` [name: 'chk_class_capacity']
  }
}

// 6. Lịch học
Table class_schedules {
  id bigserial [pk, note: 'Định danh riêng của mỗi buổi học']
  class_id bigint [not null, note: 'Tham chiếu course_classes.id; nhiều buổi có thể thuộc một lớp']
  day_of_week smallint [not null, check: `day_of_week BETWEEN 2 AND 7`, note: '2 = Thứ Hai, ..., 7 = Thứ Bảy']
  start_period smallint [not null, check: `start_period > 0`, note: 'Tiết bắt đầu của ca học']
  end_period smallint [not null, note: 'Tiết kết thúc của ca học, tính cả tiết này']
  room text [not null, note: 'Phòng học/giảng đường, ví dụ A2-301']

  checks {
    `end_period >= start_period` [name: 'chk_schedule_period']
  }
}

// 7. Đăng ký học phần
Table registrations {
  id bigserial [pk]
  student_id bigint [not null]
  class_id bigint [not null]
  status text [not null, default: 'registered', check: `status IN ('registered', 'cancelled')`]
  registered_at timestamptz [not null, default: `now()`]

  indexes {
    (student_id, class_id) [unique]
  }
}

// 8. Phiên đăng nhập
Table auth_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id bigint [not null]
  refresh_token_hash text [not null]
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  revoked_at timestamptz

  indexes {
    user_id
  }
}

// 9. Kết quả học tập
Table course_results {
  student_id bigint [not null]
  course_id bigint [not null]
  passed boolean [not null]

  indexes {
    (student_id, course_id) [pk]
    course_id
  }
}


// Quan hệ khóa ngoại
Ref: course_results.student_id > users.id
Ref: course_results.course_id > courses.id
Ref: course_prerequisites.course_id > courses.id
Ref: course_prerequisites.prerequisite_course_id > courses.id

Ref: course_classes.course_id > courses.id
Ref: course_classes.semester_id > semesters.id

Ref: class_schedules.class_id > course_classes.id [delete: cascade]

Ref: auth_sessions.user_id > users.id
Ref: registrations.student_id > users.id
Ref: registrations.class_id > course_classes.id [delete: restrict]
