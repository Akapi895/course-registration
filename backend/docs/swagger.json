{
    "swagger": "2.0",
    "info": {
        "description": "API quản lý và đăng ký học phần (Phase 1). Đăng nhập tại POST /api/auth/login, rồi bấm Authorize và nhập \"Bearer \u003caccess_token\u003e\".",
        "title": "Course Registration API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/auth/login": {
            "post": {
                "description": "Trả về access JWT và tạo một phiên trong auth_sessions.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Đăng nhập",
                "parameters": [
                    {
                        "description": "Thông tin đăng nhập",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controller.loginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.loginSuccessResponse"
                        }
                    },
                    "400": {
                        "description": "VALIDATION_ERROR",
                        "schema": {
                            "$ref": "#/definitions/controller.failResponse"
                        }
                    },
                    "401": {
                        "description": "INVALID_CREDENTIALS",
                        "schema": {
                            "$ref": "#/definitions/controller.failResponse"
                        }
                    },
                    "500": {
                        "description": "INTERNAL_ERROR",
                        "schema": {
                            "$ref": "#/definitions/controller.failResponse"
                        }
                    }
                }
            }
        },
        "/api/auth/logout": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Thu hồi phiên của JWT hiện tại. Sau đó JWT này bị từ chối.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Đăng xuất và thu hồi phiên",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.emptySuccessResponse"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED hoặc SESSION_REVOKED",
                        "schema": {
                            "$ref": "#/definitions/controller.failResponse"
                        }
                    },
                    "500": {
                        "description": "INTERNAL_ERROR",
                        "schema": {
                            "$ref": "#/definitions/controller.failResponse"
                        }
                    }
                }
            }
        },
        "/api/auth/me": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Thông tin người dùng hiện tại",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.meSuccessResponse"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED hoặc SESSION_REVOKED",
                        "schema": {
                            "$ref": "#/definitions/controller.failResponse"
                        }
                    },
                    "500": {
                        "description": "INTERNAL_ERROR",
                        "schema": {
                            "$ref": "#/definitions/controller.failResponse"
                        }
                    }
                }
            }
        },
        "/api/students/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Sinh viên chỉ xem được tài khoản của chính mình. Admin xem được mọi sinh viên.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "students"
                ],
                "summary": "Xem thông tin sinh viên",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID tài khoản sinh viên",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.studentSuccessResponse"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED hoặc SESSION_REVOKED",
                        "schema": {
                            "$ref": "#/definitions/controller.failResponse"
                        }
                    },
                    "403": {
                        "description": "FORBIDDEN",
                        "schema": {
                            "$ref": "#/definitions/controller.failResponse"
                        }
                    },
                    "404": {
                        "description": "NOT_FOUND",
                        "schema": {
                            "$ref": "#/definitions/controller.failResponse"
                        }
                    },
                    "500": {
                        "description": "INTERNAL_ERROR",
                        "schema": {
                            "$ref": "#/definitions/controller.failResponse"
                        }
                    }
                }
            },
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Thay thế họ tên, khoa và ngành. Sinh viên chỉ sửa được tài khoản của chính mình. Admin sửa được mọi sinh viên.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "students"
                ],
                "summary": "Cập nhật thông tin sinh viên",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID tài khoản sinh viên",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Thông tin cần cập nhật",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controller.updateStudentRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/controller.studentProfileSuccessResponse"
                        }
                    },
                    "400": {
                        "description": "VALIDATION_ERROR",
                        "schema": {
                            "$ref": "#/definitions/controller.failResponse"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED hoặc SESSION_REVOKED",
                        "schema": {
                            "$ref": "#/definitions/controller.failResponse"
                        }
                    },
                    "403": {
                        "description": "FORBIDDEN",
                        "schema": {
                            "$ref": "#/definitions/controller.failResponse"
                        }
                    },
                    "404": {
                        "description": "NOT_FOUND",
                        "schema": {
                            "$ref": "#/definitions/controller.failResponse"
                        }
                    },
                    "500": {
                        "description": "INTERNAL_ERROR",
                        "schema": {
                            "$ref": "#/definitions/controller.failResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "controller.emptySuccessResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "object"
                },
                "status": {
                    "type": "string",
                    "example": "success"
                }
            }
        },
        "controller.failData": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "UNAUTHORIZED"
                },
                "message": {
                    "type": "string",
                    "example": "Chưa đăng nhập hoặc phiên không hợp lệ"
                }
            }
        },
        "controller.failResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/controller.failData"
                },
                "status": {
                    "type": "string",
                    "example": "fail"
                }
            }
        },
        "controller.loginData": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string"
                }
            }
        },
        "controller.loginRequest": {
            "type": "object",
            "required": [
                "password",
                "username"
            ],
            "properties": {
                "password": {
                    "type": "string",
                    "example": "DemoUET@123"
                },
                "username": {
                    "type": "string",
                    "example": "student001"
                }
            }
        },
        "controller.loginSuccessResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/controller.loginData"
                },
                "status": {
                    "type": "string",
                    "example": "success"
                }
            }
        },
        "controller.meData": {
            "type": "object",
            "properties": {
                "full_name": {
                    "type": "string",
                    "example": "Sinh viên giả lập 001"
                },
                "id": {
                    "type": "integer",
                    "example": 7
                },
                "role": {
                    "type": "string",
                    "example": "student"
                },
                "student_code": {
                    "type": "string",
                    "example": "DEMO00001"
                },
                "username": {
                    "type": "string",
                    "example": "student001"
                }
            }
        },
        "controller.meSuccessResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/controller.meData"
                },
                "status": {
                    "type": "string",
                    "example": "success"
                }
            }
        },
        "controller.studentData": {
            "type": "object",
            "properties": {
                "faculty": {
                    "type": "string",
                    "example": "CNTT"
                },
                "full_name": {
                    "type": "string",
                    "example": "Sinh viên giả lập 001"
                },
                "id": {
                    "type": "integer",
                    "example": 7
                },
                "major": {
                    "type": "string",
                    "example": "Khoa học máy tính"
                },
                "student_code": {
                    "type": "string",
                    "example": "DEMO00001"
                },
                "username": {
                    "type": "string",
                    "example": "student001"
                }
            }
        },
        "controller.studentProfileData": {
            "type": "object",
            "properties": {
                "faculty": {
                    "type": "string",
                    "example": "CNTT"
                },
                "full_name": {
                    "type": "string",
                    "example": "Nguyễn Văn A"
                },
                "id": {
                    "type": "integer",
                    "example": 7
                },
                "major": {
                    "type": "string",
                    "example": "Khoa học máy tính"
                },
                "student_code": {
                    "type": "string",
                    "example": "DEMO00001"
                }
            }
        },
        "controller.studentProfileSuccessResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/controller.studentProfileData"
                },
                "status": {
                    "type": "string",
                    "example": "success"
                }
            }
        },
        "controller.studentSuccessResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/controller.studentData"
                },
                "status": {
                    "type": "string",
                    "example": "success"
                }
            }
        },
        "controller.updateStudentRequest": {
            "type": "object",
            "properties": {
                "faculty": {
                    "type": "string",
                    "example": "CNTT"
                },
                "full_name": {
                    "type": "string",
                    "example": "Nguyễn Văn A"
                },
                "major": {
                    "type": "string",
                    "example": "Khoa học máy tính"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Nhập đúng dạng \"Bearer \u003caccess_token\u003e\": có chữ Bearer, một khoảng trắng, rồi token.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}