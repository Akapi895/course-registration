POSTGRES_DB=course_registration
POSTGRES_USER=course_app
POSTGRES_PASSWORD=local_demo_only
POSTGRES_PORT=5432

# Backend chạy trên máy host; giữ URL khớp với POSTGRES_* ở trên.
# Docker Compose tự dùng db:5432 và thông tin POSTGRES_* cho backend trong container.
DATABASE_URL=postgresql://course_app:local_demo_only@127.0.0.1:5432/course_registration
JWT_SECRET=local_demo_only_change_this_jwt_secret
JWT_TTL=20m
SESSION_TTL=20m
LOGIN_COOLDOWN=20m
# Maximum credits used by the API; leave empty to use each semester's database value.
MAX_CREDITS=26
PORT=8080
FRONTEND_PORT=5173

REFERENCE_DATE=2026-10-20
RANDOM_SEED=20261020
